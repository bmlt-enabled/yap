APP_NAME=Yap
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Yap reads database credentials from config.php, not .env.
# These Laravel settings matter for the admin SPA and Twilio webhooks.

# Required behind reverse proxies (ngrok, load balancers). Use * or a comma-separated
# list of proxy IPs so Twilio signature validation sees the public URL Twilio signed.
# TRUSTED_PROXIES=*

# Do not use "database" — Yap's sessions table stores call PINs, not Laravel sessions.
SESSION_DRIVER=file

# Comma-separated hosts that receive session cookies for Sanctum SPA auth.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Bypass Twilio webhook signature validation outside production only. Never enable on a live helpline.
# TWILIO_DISABLE_SIGNATURE_VALIDATION=false

# Optional override for Google Maps geocoding (otherwise set in config.php).
# GOOGLE_MAPS_API_KEY=
